# Configurações do Supabase - Arquivo de exemplo
# Copie este arquivo para .env e substitua pelos valores reais

# URL do seu projeto Supabase (encontre em: Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chave pública anon do Supabase (encontre em: Settings > API)
VITE_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.your_anon_key_here
